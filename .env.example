# 复制为 .env 后填写；勿提交 .env
TUSHARE_TOKEN=
TUSHARE_PRIMARY_URL=https://tl.kaixin8.top/tushare/sdk
TUSHARE_SECONDARY_URL=https://datahubco.com/api/tushare
TUSHARE_TIMEOUT_SEC=30
TUSHARE_MIN_INTERVAL_SEC=0.35
TUSHARE_ENABLED=1

